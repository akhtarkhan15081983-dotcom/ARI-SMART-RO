DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ari_smart_ro
DB_USER=ari_smart_ro
DB_PASSWORD=replace-with-database-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Uploaded employee/customer photos must use durable storage.
# Option A: a persistent mounted volume
DJANGO_MEDIA_STORAGE_BACKEND=filesystem
DJANGO_MEDIA_ROOT=/var/lib/ari-smart-ro/media

# Option B: S3-compatible object storage (replace Option A)
# DJANGO_MEDIA_STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=replace-with-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret-key
# AWS_STORAGE_BUCKET_NAME=ari-smart-ro-media
# AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_ENDPOINT_URL=

# Customer OTP delivery. MSG91 is the production default for India.
OTP_SMS_BACKEND=msg91
OTP_SMS_COUNTRY_CODE=91
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_TEMPLATE_ID=replace-with-approved-msg91-template-id
